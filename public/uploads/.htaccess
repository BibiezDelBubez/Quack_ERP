# Disabilita l'esecuzione di script PHP e di altri file eseguibili per motivi di sicurezza
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|htm|shtml|sh|cgi)$">
    Require all denied
</FilesMatch>

# Disabilita il motore PHP se supportato dal server
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
