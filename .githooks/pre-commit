#!/bin/sh
# Pre-commit hook — blocca il commit se uno dei file "staged" ha un encoding
# non-UTF8 o contiene già caratteri di sostituzione U+FFFD (segno di una
# corruzione di encoding avvenuta in passato, es. testo incollato in
# Windows-1252/Latin-1 dentro un file UTF-8 — successo davvero in
# db/init_sqlite.sql, vedi tools/check-utf8.php per i dettagli).
#
# Questo file vive in .githooks/ (versionato, condiviso col repo) invece che
# in .git/hooks/ (locale, mai sincronizzato da git) proprio per evitare che la
# protezione sparisca a un nuovo clone o checkout. Per attivarlo la prima
# volta in un checkout locale:
#
#   git config core.hooksPath .githooks
#
# Da quel momento gira automaticamente ad ogni "git commit".

REPO_ROOT=$(git rev-parse --show-toplevel)
FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$FILES" ]; then
    exit 0
fi

if ! command -v php >/dev/null 2>&1; then
    echo "[pre-commit] 'php' non trovato nel PATH: controllo encoding e analisi statica saltati (non bloccante)." >&2
    echo "[pre-commit] Per attivarli, assicurati che il php di XAMPP sia nel PATH di questo terminale." >&2
    exit 0
fi

php "$REPO_ROOT/tools/check-utf8.php" $FILES
UTF8_STATUS=$?
if [ $UTF8_STATUS -ne 0 ]; then
    exit $UTF8_STATUS
fi

# Analisi statica PHPStan sui file .php staged (Bug 1, 10/08/2026: un errore
# come "Call to undefined function qk_pagination()" — mai esistita, solo un
# refuso rispetto a qk_paginate() — era già segnalato da PHPStan da tempo, ma
# solo se lanciato a mano; nessuno lo faceva prima di ogni commit, ed è
# arrivato in produzione. Vedi
# audit/PIANO - Correzioni Enterprise Post-Test Manuale (10-08-2026).md, §1).
#
# Non bloccante se le dipendenze non sono installate (stesso principio
# difensivo del controllo 'php' sopra): un checkout senza 'composer install'
# non deve impedire di committare, ma perde la protezione finché non lo fa.
PHP_FILES=$(printf '%s\n' "$FILES" | grep '\.php$')
if [ -n "$PHP_FILES" ]; then
    if [ ! -x "$REPO_ROOT/vendor/bin/phpstan" ]; then
        echo "[pre-commit] 'vendor/bin/phpstan' non trovato: analisi statica saltata (non bloccante)." >&2
        echo "[pre-commit] Per attivarla: composer install." >&2
        exit 0
    fi
    php "$REPO_ROOT/vendor/bin/phpstan" analyse --no-progress
    exit $?
fi

exit 0
