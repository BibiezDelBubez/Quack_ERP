# Dipendenze gestite da Composer (rigenerabili con: composer install)
/vendor/

# File temporanei
/uploads/mpdf_tmp/
/scratch/

# Script di utilità (non servono in produzione)
check_vendor_size.php
cleanup_vendor_fonts.php
uploads/gen_header.php

# File di test PDF (temporanei)
test_mpdf.php
test_tcpdf.php

# IDE / OS
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# File di supporto
/file supporto/

# DB SQLite: ora vive fuori progetto (DB_DIR in config.php); questi pattern
# proteggono nel caso qualcuno lo ricrei per errore dentro db/
db/*.sqlite
db/.fuse_hidden*

# Runtime PHP portatile per il sandbox di sviluppo senza root (vedi
# tools/dev-php-sandbox/README.md) — binari scaricati, rigenerabili in pochi
# secondi con setup.sh, non hanno senso in un repository git.
/tools/dev-php-sandbox/runtime/
/tools/dev-php-sandbox/.debs-cache/

# Stessa cosa ma finita per errore nella root del progetto invece che in
# tools/dev-php-sandbox/ (probabile setup.sh lanciato dalla cartella
# sbagliata in una sessione precedente). Contiene simlink Linux che
# rompono "git add" su Windows ("Function not implemented") — va ignorata.
/runtime/
/.debs-cache/

# Test E2E Python / Playwright
tests/e2e/.venv/
.pytest_cache/
__pycache__/
playwright-report/
test-results/

# Ignora node_modules nei test manuali
tests/manual/js/node_modules/
tests/manual/js/node_modules_todelete
tests/manual/js/test_symlink_probe


# Segreti locali (mai committare)
/.env

# Backup automatici del DB (creati da includes/db.php ad ogni rebuild schema)
db/*.bak
db/backups/

# Cronologie di conversazione con Claude (pesanti, materiale interno)
docs/*.jsonl

# Materiale di lavoro/audit: contiene spesso segreti in chiaro (gia' successo
# due volte). Tienilo solo locale.
/audit/

# Segreti pronti per un setup su PC nuovo (contiene chiavi vere, mai committare)
/credenziali-locali/

# File con dati/chiavi WooCommerce in chiaro (tolti dal tracking il 20/08, solo locali)
docs/dati WooCommerce/Chiavi API Quack ERP.pdf
docs/dati WooCommerce/woo-blueprint.json
