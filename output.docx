<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — Quack ERP</title>
  <link rel="icon" href="/assets/img/logo_quack.png" type="image/png">
  <link rel="stylesheet" href="/assets/css/bootstrap.min.css?v=1780469110">
  <link rel="stylesheet" href="/assets/css/login.css?v=1780469110">
</head>
<body class="qk-login-body qk-skin-a">

  <main class="qk-pool" id="qk-pool" role="main">
    <div class="qk-content">
      <!--
<div class="qk-logo-wrap">
  <svg class="qk-logo-mark" viewBox="0 0 48 48"
       xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="5" y="5" width="38" height="38" rx="11"
          fill="none" stroke="currentColor" stroke-width="2.2"/>
